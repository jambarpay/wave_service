# Wave Service
WAVE_SERVICE_NAME=wave-service
WAVE_SERVICE_PORT=8088

# Eureka
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
EUREKA_REGISTER=true
EUREKA_FETCH=true
EUREKA_INSTANCE_HOSTNAME=wave-service
EUREKA_PREFER_IP_ADDRESS=false

# PayDunya HTTP/JSON (keys from the same application in test mode)
PAYDUNYA_SANDBOX=true
PAYDUNYA_MASTER_KEY=your-master-key
PAYDUNYA_PRIVATE_KEY=your-test-private-key
PAYDUNYA_TOKEN=your-test-token
PAYDUNYA_STORE_NAME=JambaarPay

JWT_ISSUER=jambaarpay-user-service
JWT_SECRET=replace-with-the-same-random-secret-used-by-user-service-and-api-gateway
